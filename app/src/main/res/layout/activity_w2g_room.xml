<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBarW2G"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnLeaveW2G"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvW2GRoomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvW2GRoomSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent_gold"
                android:textSize="11sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyRoomCode"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/bg_card"
            android:text="Salin Kode"
            android:textColor="@color/accent_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- Video Area -->
    <FrameLayout
        android:id="@+id/videoContainerW2G"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@android:color/black">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerViewW2G"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:controller_layout_id="@layout/custom_player_controls"
            app:resize_mode="fit"
            app:surface_type="surface_view"
            app:use_controller="true" />

        <ProgressBar
            android:id="@+id/pbW2GVideoLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_gold" />

        <!-- Sync Indicator Badge -->
        <TextView
            android:id="@+id/tvSyncBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge_dark"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="● Tersinkronisasi"
            android:textColor="@color/accent_gold"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Tabs: Chat & Members -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabW2GRoom"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_surface"
        app:tabIndicatorColor="@color/accent_gold"
        app:tabSelectedTextColor="@color/accent_gold"
        app:tabTextColor="@color/text_muted">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Chat" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Penonton" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Bottom Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 0: Live Chat -->
        <LinearLayout
            android:id="@+id/layoutW2GChatTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvW2GChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/etW2GChatMessage"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:hint="Komentar live..."
                    android:imeOptions="actionSend"
                    android:inputType="textShortMessage"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnSendW2GChat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_gold"
                    android:src="@drawable/ic_play"
                    app:tint="@color/bg_dark" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tab 1: Members List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvW2GMembers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="10dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
