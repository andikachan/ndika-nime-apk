<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buat Clan Baru"
        android:textColor="@color/accent_gold"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCreateClanName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_search_input"
        android:hint="Nama Clan (mis: Akatsuki)"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etCreateClanTag"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_input"
        android:hint="Tag Clan 3-5 huruf (mis: AKAT)"
        android:maxLength="5"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etCreateClanDesc"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_input"
        android:hint="Deskripsi Singkat"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitCreateClan"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/accent_gold"
        android:text="Buat Clan Sekarang"
        android:textColor="@color/bg_dark"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</LinearLayout>
