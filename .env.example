# ===== NDICHAN — CONTOH ENV VARS =====
# Copy file ini jadi .env buat lokal (vercel dev otomatis baca .env), atau
# masukin satu-satu ke Vercel > Project Settings > Environment Variables.

# ----- Auth / JWT -----
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# ----- Google OAuth Login -----
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxx

# ----- Upstash Redis -----
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxx

# ----- Frontend URL (buat redirect OAuth & CORS) -----
FRONTEND_URL=https://ndichan.xyz

# ----- Admin (fallback super admin, bisa diisi banyak dipisah koma) -----
ADMIN_USER_IDS=user_xxxxxxxxxx

# ----- Email pengirim (Gmail SMTP, fallback kalau belum diatur lewat panel admin) -----
GMAIL_USER=namamu@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM=ndika@ndichan.xyz

# ----- Cron job notifikasi anime/komik baru -----
# Secret ini dipakai buat lindungi /api/v1/cron/notify supaya nggak bisa
# dipicu sembarang orang. Isi bebas asal panjang & acak, lalu pasang query
# ?secret=... yang SAMA PERSIS di URL cron job kamu (lihat cron-job.org).
CRON_NOTIFY_SECRET=ganti-dengan-string-acak-yang-panjang

# ----- Cron job backup Redis otomatis ke Telegram -----
# Sengaja dibikin secret TERPISAH dari CRON_NOTIFY_SECRET, biar kalau salah
# satu bocor, yang lain masih aman. Bot token & chat ID Telegram-nya sendiri
# diatur dari panel admin (tab "Backup & Restore"), bukan lewat env.
CRON_BACKUP_SECRET=ganti-dengan-string-acak-yang-panjang-juga

# ----- Lain-lain -----
NODE_ENV=production
